# DEVELOPMENT_ENV=true  ← Bỏ comment để bật debug
DEBUG=true
LOG_LEVEL=DEBUG

# ─── LLM Provider ────────────────────────────────────────────────────────────
# Chọn một trong: openai | anthropic | local
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-key-here
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# ─── ChromaDB ────────────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=solar_knowledge_base

# ─── Embedding ───────────────────────────────────────────────────────────────
EMBEDDING_MODEL=keepitreal/vietnamese-sbert
EMBEDDING_DEVICE=cpu

# ─── CORS ────────────────────────────────────────────────────────────────────
# CORS_ORIGINS=["http://localhost:3000","https://app.nlpgroup.vn"]
